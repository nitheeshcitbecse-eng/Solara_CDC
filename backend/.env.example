

APP_ENV=development
# true on hosts without a shell (Render free): creates the sectors and the admin account on start-up
SEED_ON_START=false


# Local PostgreSQL, or Neon's connection string as is (postgresql://…?sslmode=require)
DATABASE_URL=postgresql+psycopg://postgres:YOUR_PASSWORD@localhost:5432/solara

# Long random string. Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_EXPIRE_DAYS=7

# Uploaded images (job photos are public, Aadhaar documents are admin-only)
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=8

# Password-reset emails. Leave SMTP_HOST empty to print codes in the server log (development).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Solara <no-reply@solara.app>

# Owner account created by `python -m app.seed`
ADMIN_EMAIL=owner@solara.app
ADMIN_PASSWORD=Solara@123

# Local NLLB-200 translator service, used when AZURE_TRANSLATOR_KEY is empty (see ../translator/README.md)
TRANSLATOR_URL=http://127.0.0.1:5000
TRANSLATOR_TIMEOUT=120
# Azure AI Translator (recommended, free F0 tier). Leave the key empty to use the local NLLB service above.
AZURE_TRANSLATOR_KEY=
AZURE_TRANSLATOR_REGION=centralindia
