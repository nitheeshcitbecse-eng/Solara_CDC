# ─────────────────────────────────────────────────────────────────────────────
# Solara mobile environment.
# Copy to `.env` (git-ignored) and adjust.
#
# IMPORTANT: every EXPO_PUBLIC_* value is inlined into the JavaScript bundle and
# can be read by anyone who downloads the app. NEVER put secrets here
# (API keys with write access, client secrets, signing keys, passwords).
# ─────────────────────────────────────────────────────────────────────────────

# Base URL of the Node/Express API, including the version prefix.
# Android emulator → http://10.0.2.2:4000/api/v1 · physical device → your LAN IP.
EXPO_PUBLIC_API_URL=http://localhost:4000/api/v1

# true  → every request is answered by the in-app mock (src/services/mock).
# false → requests go to EXPO_PUBLIC_API_URL. Must be false in production.
EXPO_PUBLIC_USE_MOCK_API=true

# development | staging | production. Production requires https and no mock.
EXPO_PUBLIC_APP_ENV=development

# Native Google Sign-In needs a development build (not Expo Go).
# When false, or when running inside Expo Go, the Google button signs in via the mock.
EXPO_PUBLIC_ENABLE_GOOGLE_SIGNIN=false

# OAuth *web* client id used to request an idToken (public by design, not a secret).
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# Build-time only (not bundled): reversed iOS client id, e.g. com.googleusercontent.apps.123-abc
GOOGLE_IOS_URL_SCHEME=

# Remote push registration is a stub until the backend + a dev build exist.
EXPO_PUBLIC_ENABLE_PUSH=false
