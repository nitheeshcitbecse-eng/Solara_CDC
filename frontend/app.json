{
  "expo": {
    "name": "Solara",
    "slug": "solara",
    "scheme": "solara",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "backgroundColor": "#f7f5f2",
    "ios": {
      "bundleIdentifier": "app.solara.jobs",
      "supportsTablet": false,
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "app.solara.jobs",
      "adaptiveIcon": {
        "backgroundColor": "#140c06",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "softwareKeyboardLayoutMode": "resize"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "backgroundColor": "#140c06"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Solara needs your photos to attach workplace pictures and identity documents.",
          "cameraPermission": "Solara uses the camera to photograph your workplace or identity documents.",
          "microphonePermission": false
        }
      ],
      "expo-asset"
    ]
  }
}
